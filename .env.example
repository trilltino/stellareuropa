# Database Configuration
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD_HERE@localhost:5432/stellareurope

# JWT Configuration (must be at least 32 characters)
JWT_SECRET=your-secure-jwt-secret-minimum-32-characters-change-this-in-production

# Cookie Configuration
COOKIE_NAME=stellar_auth
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false  # true in production with HTTPS
COOKIE_HTTP_ONLY=true
COOKIE_SAME_SITE=Lax

# Server Configuration
RUST_LOG=info
